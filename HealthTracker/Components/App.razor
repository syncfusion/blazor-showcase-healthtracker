@inject NavigationManager Urihelper

@* SEO Variables - Single source of truth for all meta tags *@
@{
    string SeoTitle = "Health Tracker - Syncfusion Blazor Showcase";
    string SeoDescription = "Monitor calories, steps, water intake, and sleep data with visual health tracking dashboards.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "Health Tracker";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/HealthTracker.svg";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <!-- HTML Title -->
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="health tracker, wellness, calorie tracking, fitness, health monitoring" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/healthcare-tracker/blazor/wasm/" rel="canonical" />
    
    <!-- Alternate Language Tags -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <!-- Google Tag Manager -->
    <!-- Load GTM-WXZ6DX9B immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];
            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/bootstrap/bootstrap.min.css"]" />
    <link href="@Assets["_content/Syncfusion.Blazor.Themes/fluent2.css"]" rel="stylesheet" />
    <link href="manifest.json" rel="manifest" />
    <link href="css/icomoon.eot" rel="stylesheet" />
    <link href="css/icomoon.svg" rel="stylesheet" />
    <link href="css/icomoon.ttf" rel="stylesheet" />
    <link href="css/icomoon.woff" rel="stylesheet" />
    <link href="@Assets["styles/material.css"]" rel="stylesheet" />
    <link href="@Assets["styles/main.css"]" rel="stylesheet" />
    <link href="@Assets["css/cards.css"]" rel="stylesheet" />
    <link href="@Assets["css/Calorie.css"]" rel="stylesheet" />
    <link href="@Assets["css/steps.css"]" rel="stylesheet" />
    <link href="@Assets["css/water.css"]" rel="stylesheet" />
    <link href="@Assets["css/sleep.css"]" rel="stylesheet" />
    <link href="@Assets["css/health-tracker.css"]" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i" rel="stylesheet" />
    <script src="https://github.com/Daddoon/Blazor.Polyfill/releases/download/3.0.1/blazor.polyfill.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.20/lodash.min.js"></script>

    <!-- Schema.org Structured Data - SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "WebAssembly enabled browser",
      "image": "@SocialImage",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "inLanguage": "en-US"
    }
    </script>

    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div hidden id="sync-analytics" data-queue="EJ2 - Showcase - Blazor - HealthTracker"></div>
    <app>
        <div class="sb-content-overlay">
            <h2 id="title">Syncfusion Blazor Health Tracker</h2>
            <div id="description">Initializing the WebAssembly Application</div>
            <div class="sb-loading initial">
                <svg class="circular" height="40" width="40">
                    <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="6" stroke-miterlimit="10" />
                </svg>
            </div>
        </div>
    </app>
    <Routes @rendermode="InteractiveWebAssembly" />
    <script>
        setTimeout(function () {
            var overlayEle = document.querySelector(".sb-content-overlay");
            if (overlayEle) {
                overlayEle.style.display = "none";
            }
        }, 4000);
   </script>
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
